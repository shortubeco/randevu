# Yerel geliştirme için kopyalayıp .env olarak adlandırın.
# Gerçek değerleri buraya değil, .env dosyasına veya cPanel'in
# Environment variables bölümüne girin. .env git'e girmez.

# PostgreSQL bağlantı adresi (cPanel PostgreSQL Database Wizard'dan)
DATABASE_URL=postgresql://KULLANICI:SIFRE@localhost:5432/VERITABANI

# Access token imzalama anahtarı. Uzun, rastgele bir değer olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=BURAYA_RASTGELE_DEGER

# Uygulama portu (cPanel bunu otomatik atar; yerelde boş bırakılırsa 3000 kullanılır)
PORT=3000

# İzin verilen web adresleri (virgülle). Tanımlanırsa koddaki varsayılanın yerine geçer.
# CORS_ORIGINS=https://kuafor.trthabercanli.com,http://localhost:5173
